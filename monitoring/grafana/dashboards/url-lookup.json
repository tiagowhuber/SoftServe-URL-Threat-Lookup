        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(url_lookup_cache_misses_total[30s]))", "legendFormat": "cache misses (→ Redis)", "refId": "B" }
      ],
      "title": "LRU Cache — hits vs Redis lookups",
