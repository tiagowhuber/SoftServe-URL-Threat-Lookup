      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.50, sum(rate(url_lookup_duration_seconds_bucket[30s])) by (le))", "legendFormat": "read p50", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.95, sum(rate(url_lookup_duration_seconds_bucket[30s])) by (le))", "legendFormat": "read p95", "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.99, sum(rate(url_lookup_duration_seconds_bucket[30s])) by (le))", "legendFormat": "read p99", "refId": "C" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.99, sum(rate(url_write_duration_seconds_bucket[30s])) by (le))", "legendFormat": "write p99", "refId": "D" }
      ],
      "title": "Latency — reads p50/p95/p99 + write p99",
      "type": "timeseries"
    },
    {
